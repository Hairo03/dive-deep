@model dive_deep.Models.DiveConditionsViewModel

<h2>Dykkerforhold</h2>

<form method="post">
    <label>By:</label>
    <input type="text" name="by"/>
    <button type="submit">Tjek</button>
</form>

@if (Model != null)
{
    <div>
        <p><strong>Vind:</strong> @Model.WindSpeed m/s</p>
        <p><strong>Bølger:</strong> @Model.WaveHeight m</p>
        <p><strong>Nedbør:</strong> @Model.Precipitation mm/t</p>
    </div>
}
